# ccguard QA runtime env — copy to deploy/qa.env and fill in the secrets.
# This file is pushed to <remotePath>/qa.env and loaded by the systemd unit
# (EnvironmentFile). deploy/qa.env is gitignored; this .example is committed.
#
# NOTE: the database URL and logging config now live in deploy/qa-ccg.json
# (pushed to <remotePath>/configuration/ccg.json), NOT here. See
# deploy/qa-ccg.json.example.

# The app binds here. nginx reverse-proxies https://ccguard-qa-1.landessware.com
# to this address, so it stays on localhost. The deploy forces this value if missing.
CCGUARD_BIND=127.0.0.1:7070

# Guards the admin-only endpoints POST /v1/tenants and POST /v1/users.
ADMIN_TOKEN=CHANGE_ME

# Optional: server-side AI triage via the Anthropic API. Off by default — the
# primary classification path runs through each employee's local Claude Code seat.
#ANTHROPIC_API_KEY=
#ANTHROPIC_BASE_URL=
